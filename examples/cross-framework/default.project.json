{
  "name": "rbxts-svg-cross-framework",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "rbxts_include": {
        "$path": "include",
        "node_modules": {
          "$className": "Folder",
          "@rbxts": { "$path": "node_modules/@rbxts" }
        }
      },
      "TS": { "$path": "out" }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "TS": { "$path": "out/client" }
      }
    }
  }
}
