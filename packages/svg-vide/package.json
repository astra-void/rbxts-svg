  },
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/svg": "workspace:*",
    "@rbxts/types": "^1.0.942",
    "@rbxts/vide": "^0.6.1",
    "roblox-ts": "^3.0.0",
    "typescript": "5.5.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
