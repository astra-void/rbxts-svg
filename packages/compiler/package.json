{
  "name": "@rbxts/svg-compiler",
  "version": "0.1.0",
  "description": "Build-time SVG compiler for @rbxts/svg. Wraps the native binary behind a stable TypeScript API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astra-void/rbxts-svg.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/astra-void/rbxts-svg/tree/main/packages/compiler#readme",
  "bugs": {
    "url": "https://github.com/astra-void/rbxts-svg/issues"
  },
  "keywords": [
    "roblox",
    "roblox-ts",
    "svg",
    "compiler",
    "cli",
    "build-tool"
  ],
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "default": "./dist/paths.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "rbxts-svg": "dist/cli.js"
  },
  "engines": {
    "node": "^20.17.0 || ^22.13.0 || >= 23.5.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@rbxts/svg-native": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "5.5.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
