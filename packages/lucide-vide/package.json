{
  "name": "@rbxts/lucide-vide",
  "version": "0.1.0",
  "description": "Lucide icons for roblox-ts Vide, precompiled through @rbxts/svg",
  "license": "MIT AND ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbxts-svg/rbxts-svg.git",
    "directory": "packages/lucide-vide"
  },
  "keywords": [
    "roblox",
    "roblox-ts",
    "vide",
    "svg",
    "icons",
    "lucide"
  ],
  "main": "out/init.luau",
  "types": "out/index.d.ts",
  "typesVersions": {
    "*": {
      "icons/*": [
        "out/generated/icons/*"
      ]
    }
  },
  "files": [
    "out",
    "LICENSE",
    "LICENSE-lucide"
  ],
  "scripts": {
    "build": "rbxtsc --type=package",
    "watch": "rbxtsc -w --type=package",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@rbxts/svg": "^0.1.0",
    "@rbxts/svg-vide": "^0.1.0",
    "@rbxts/vide": "^0.6.1"
  },
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/svg": "workspace:*",
    "@rbxts/svg-vide": "workspace:*",
    "@rbxts/types": "^1.0.942",
    "@rbxts/vide": "^0.6.1",
    "roblox-ts": "^3.0.0",
    "typescript": "5.5.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
